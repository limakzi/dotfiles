#!/bin/sh
## Cross-platform pbpaste: print the clipboard to stdout on macOS and Linux.

if [ "$(uname -s)" = Darwin ]; then
    exec /usr/bin/pbpaste "$@"
elif [ -n "$WAYLAND_DISPLAY" ] && command -v wl-paste >/dev/null; then
    exec wl-paste --no-newline
elif command -v xclip >/dev/null; then
    exec xclip -selection clipboard -out
elif command -v xsel >/dev/null; then
    exec xsel --clipboard --output
fi

echo "pbpaste: no clipboard tool found (install wl-clipboard, xclip or xsel)" >&2
exit 1
