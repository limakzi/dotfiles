## {{{1 Keyboard shortcuts.

## {{{2 keyboard shortcuts -- unbound defaults
map d
map y
map p
map c
map u
map s
map M
map w
map [
map ]
map sn
map ss
map st
map sa
map sc
map se
map zn
map zs
map zt
map za
## }}}2

## {{{2 keyboard shortcuts -- general
map Q quit
map ZZ quit
map ZQ quit
map R reload
map i $$PAGER "$f"
map E $$EDITOR "$f"
map S $$SHELL
map ? doc
map s shell
map r shell-async
map cd push :cd<space>
map <enter> open
## }}}2

## {{{2 keyboard shortcuts -- movement
map J half-down
map K half-up
map H jump-prev
map L jump-next
## }}}2

## {{{2 keyboard shortcuts -- selecting and tagging
map uv unselect
map t tag-toggle
map ut :tag; tag-toggle
## }}}2

## {{{2 keyboard shortcuts -- copying, cutting and pasting
map yy copy
map dd cut
map pp paste
map ud clear
map uy clear
map dD delete
map dc calcdirsize
map du !du --max-depth=1 -h --apparent-size
map dU !du --max-depth=1 -h --apparent-size | sort -rh
## }}}2

## {{{2 keyboard shortcuts -- yanking to the clipboard
map yp %printf '%s' "$fx" | xclip -selection clipboard
map yd %printf '%s' "$PWD" | xclip -selection clipboard
map yn %basename "$f" | xclip -selection clipboard
map y. %basename "$f" | sed 's/\.[^.]*$//' | xclip -selection clipboard
## }}}2

## {{{2 keyboard shortcuts -- renaming
map cw push :rename<space>
map a rename
map A push a<c-e>
map I push a<c-a>
## }}}2

## {{{2 keyboard shortcuts -- changing directories
map gh cd ~
map ge cd /etc
map gu cd /usr
map gd cd /dev
map go cd /opt
map gv cd /var
map gm cd /media
map gM cd /mnt
map gs cd /srv
map gp cd /tmp
map gr cd /
map g/ cd /
map gi cd /run/media/$USER
map gl &lf -remote "send $id cd \"$(realpath -- "$PWD")\""
map gL &lf -remote "send $id select \"$(realpath -- "$f")\""
## }}}2

## {{{2 keyboard shortcuts -- bookmarks
map ` mark-load
map um mark-remove
## }}}2

## {{{2 keyboard shortcuts -- sorting
map or set reverse!
map on :set sortby natural; set info; set noreverse
map ob :set sortby name; set info; set noreverse
map os :set sortby size; set info size; set noreverse
map om :set sortby time; set info custom; set noreverse
map oc :set sortby ctime; set info ctime; set noreverse
map oa :set sortby atime; set info atime; set noreverse
map oe :set sortby ext; set info; set noreverse
map oN :set sortby natural; set info; set reverse
map oB :set sortby name; set info; set reverse
map oS :set sortby size; set info size; set reverse
map oM :set sortby time; set info custom; set reverse
map oC :set sortby ctime; set info ctime; set reverse
map oA :set sortby atime; set info atime; set reverse
map oE :set sortby ext; set info; set reverse
## }}}2

## {{{2 keyboard shortcuts -- settings
map zh set hidden!
map zd set dirfirst!
map zp set preview!
map zf filter
map zz filter
## }}}2

## {{{2 keyboard shortcuts -- line modes
map Mf set info
map Ms set info size
map Mm set info custom
map Mp set info perm
map MH set info size:custom
## }}}2

## {{{2 keyboard shortcuts -- creating files
map <insert> push $touch<space>
map N push :mkdir<space>
## }}}2

## {{{2 keyboard shortcuts -- fzf jump
map <c-p> fzf_jump
## }}}2

