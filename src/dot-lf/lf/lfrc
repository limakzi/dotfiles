## vim: ft=conf

## {{{1 Appearance.
set icons true
set drawbox true
set relativenumber true
set number true
set ratios 1:3:3
set rulerfile ~/.config/lf/ruler
## }}}1

## {{{1 Behaviour.
set ignorecase true
set smartcase true
set dirfirst true
## }}}1

## {{{1 Directory specific settings.
setlocal ~/Downloads sortby time
setlocal ~/Downloads info custom
setlocal ~/Downloads reverse
## }}}1

## {{{1 Commands.
cmd on-load &{{
    [ $# -gt 0 ] || exit 0
    printf '%s\0' "$@" | xargs -0 stat -f '%m %N' 2>/dev/null | awk -v now="$(date +%s)" '
        function plural(x, unit,   v) { v = int(x); return (v < 2 ? 2 : v) " " unit }
        function relative(d,   a, prefix, suffix) {
            a = d < 0 ? -d : d
            prefix = d < 0 ? "in " : ""
            suffix = d < 0 ? "" : " ago"
            if (a <= 10)       return "now"
            if (a <= 45)       return prefix int(a) " seconds" suffix
            if (a <= 90)       return prefix "a minute" suffix
            if (a <= 2700)     return prefix plural(a / 60, "minutes") suffix
            if (a <= 5400)     return prefix "an hour" suffix
            if (a <= 79200)    return prefix plural(a / 3600, "hours") suffix
            if (a <= 129600)   return prefix "a day" suffix
            if (a <= 561600)   return prefix plural(a / 86400, "days") suffix
            if (a <= 907200)   return prefix "a week" suffix
            if (a <= 2591999)  return prefix plural(a / 604800, "weeks") suffix
            if (a <= 3888000)  return prefix "a month" suffix
            if (a <= 29808000) return prefix plural(a / 2592000, "months") suffix
            if (a <= 47260800) return prefix "a year" suffix
            return prefix plural(a / 31536000, "years") suffix
        }
        $1 !~ /^[0-9]+$/ { next }
        {
            name = substr($0, index($0, " ") + 1)
            info = relative(now - $1)
            gsub(/\\/, "\\\\", name)
            gsub(/"/, "\\\"", name)
            cmds = cmds "addcustominfo \"" name "\" \"" info "\"; "
            if (++count % 1000 == 0) { print cmds; cmds = "" }
        }
        END { if (cmds != "") print cmds }
    ' | while IFS= read -r cmds; do
        lf -remote "send $id :$cmds"
    done
}}

cmd fzf_jump ${{
    res="$(fdfind -H -t d '^\.git$' "$HOME" -0 2>/dev/null | xargs -0 -r -n 1 dirname | tr '\n' '\0' | xargs -0 -r lsd -d -1 --icon=always --color=always 2>/dev/null | fzf --ansi | sed 's/\x1b\[[0-9;]*m//g' | sed 's/^[^ ]* //' | sed 's/ ⇒ .*//')"
    res="${res%/}"
    if [ -n "$res" ]; then
        lf -remote "send $id cd \"$res\""
    fi
}}

cmd mkdir %{{
    set -f
    mkdir -p -- "$@" && lf -remote "send $id reload"
}}

cmd open ${{
    case "$(file --mime-type -Lb "$f")" in
        text/*|application/json|application/javascript|application/xml|inode/x-empty)
            $EDITOR "$f"
            ;;
        *)
            xdg-open "$f" >/dev/null 2>&1 &
            ;;
    esac
}}
